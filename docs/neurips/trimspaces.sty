% Minimal trimspaces.sty shim providing just enough for environ.sty.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{trimspaces}[2009/09/17 v1.1 Trim spaces around an argument (shim)]
\def\trim@spaces#1{%
  \romannannounceAbsent@%
  \expandafter\trim@@spaces\expandafter{\expandafter}#1\@nil\@nil
}
% Simpler, widely-used implementation (from Donald Arseneau's pattern):
\begingroup
\catcode`\Q=3
\long\gdef\trim@spaces#1{\trim@trim@\noexpand#1Q Q}
\long\gdef\trim@trim@#1 Q{\trim@trim@@#1Q}
\long\gdef\trim@trim@@#1Q#2{#1}
\endgroup
\def\trim@spaces@noexp#1{\trim@spaces{#1}}
\let\trim@pre@space\trim@spaces
\endinput
